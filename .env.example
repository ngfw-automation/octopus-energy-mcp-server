# --- Required -----------------------------------------------------------
# Octopus Energy API key (create at https://octopus.energy/dashboard/developer/)
OCTOPUS_API_KEY=
# Your account number, e.g. A-XXXX1234 (visible in the dashboard URL / on bills)
OCTOPUS_ACCOUNT_NUMBER=

# --- Optional: pin default meters ---------------------------------------
# If omitted, the server uses the sole meter for a fuel, or returns a
# disambiguation list when a fuel has more than one meter point.
# OCTOPUS_ELECTRICITY_MPAN=
# OCTOPUS_ELECTRICITY_SERIAL=
# OCTOPUS_GAS_MPRN=
# OCTOPUS_GAS_SERIAL=
# OCTOPUS_EXPORT_MPAN=

# --- Optional: default payment method -----------------------------------
# Variable tariffs price by payment method (direct debit is usually
# discounted). Set this so get_unit_rates and GBP cost calculations pick
# your rate. Values: DIRECT_DEBIT or NON_DIRECT_DEBIT.
# DEFAULT_PAYMENT_METHOD=DIRECT_DEBIT

# --- Optional: gas units -------------------------------------------------
# SMETS1 gas meters report kWh over the API; SMETS2 meters report m3. The
# account payload does not say which yours is, so pin it here -- otherwise
# kWh is assumed and every gas response carries a warning.
# Values: kwh or m3
# OCTOPUS_GAS_UNITS=m3
#
# Calorific value in MJ/m3 for the m3 -> kWh conversion
# (kWh = m3 x CV x 1.02264 / 3.6). It is printed on your gas bill and varies
# by region and period; 39.5 (the default) gives ~11.22 kWh/m3.
# GAS_CALORIFIC_VALUE=39.5

# --- Optional: standing charge override (pence per day, VAT INCLUSIVE) ----
# Not normally needed: the standing charge published for your tariff is used
# automatically. Set this only if your bill shows a different figure -- give
# it exactly as the dashboard does, VAT included (50.88 = 50.88p/day) -- and
# it takes precedence in every cost calculation.
# STANDING_CHARGE_ELECTRICITY=
# STANDING_CHARGE_GAS=

# --- Optional: HTTP server binding (default transport is streamable HTTP) --
# Bind address and port for the HTTP (Streamable MCP) server. The Docker
# stack sets MCP_HOST=0.0.0.0 so NGINX can reach it on the internal network.
# Use `octopus-mcp --stdio` for the legacy stdio transport instead.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# --- Optional: cache TTLs (seconds) -------------------------------------
# CACHE_TTL_PRODUCTS=86400
# CACHE_TTL_RATES=86400
# CACHE_TTL_CONSUMPTION=1800
# CACHE_TTL_ACCOUNT=3600

# --- Optional: downsample caps ------------------------------------------
# Maximum number of aggregated buckets / rate rows returned before truncation
# MAX_ROWS_RETURNED=500
# Widest range include_raw will answer for, in days (one row per half hour)
# MAX_RAW_DAYS=2

# --- Optional: extra hostnames the server answers to ---------------------
# The server validates the Host and Origin headers (DNS-rebinding protection).
# localhost and 127.0.0.1 on any port are allowed out of the box. Add anything
# else that clients dial it by -- e.g. a Tailscale MagicDNS name. Comma
# separated. A rejected request is logged with the exact Host it carried.
# MCP_ALLOWED_HOSTS=brown.tailnet-name.ts.net
# MCP_ALLOWED_ORIGINS=

# --- Optional: logging ---------------------------------------------------
# JSON lines on stderr. The API key is redacted and account/meter identifiers
# are masked. DEBUG, INFO (default), WARNING, ERROR.
# LOG_LEVEL=INFO
